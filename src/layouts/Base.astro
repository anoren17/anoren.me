---
// The one shared page shell: <head>, fonts, nav, footer, and the tiny pre-paint script.
import '@fontsource-variable/bricolage-grotesque/wght.css';   // weight axis only: 41 kB instead of 131 kB
import '@fontsource-variable/onest/wght.css';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/creed.css';
import { nav, type PageKey } from '../data/site';
import { script } from '../fonts/script';

interface Props {
  page: PageKey;
  title: string;
  description: string;
  /** emoji used as the tab icon */
  emoji: string;
}
const { page, title, description, emoji } = Astro.props;

const icon = 'data:image/svg+xml,' + encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><text y="26" font-size="26">${emoji}</text></svg>`,
);
// First CSS the browser sees. It must carry the page-transition opt-in: this inline style is parsed before
// the main stylesheet, and if the opt-in only lived there the browser could decide "no transition" too early
// (measured: 7 of 12 page changes lost their morph). The same rules are repeated in site.css.
const firstCss =
  `@view-transition{navigation:auto}@media (prefers-reduced-motion:reduce){@view-transition{navigation:none}}` +
  `@font-face{font-family:'Script';src:url(${script.url}) format('woff2');font-display:block}:root{--script-scale:${script.scale}}`;
const others = [{ key: 'home', href: '/' }, ...nav].filter(p => p.key !== page);
// Sync-in slices: vertical position %, thickness px, length %, delay ms, duration ms.
const slices = [
  { y: 9, h: 2, w: 70, d: 40, t: 520 }, { y: 18, h: 9, w: 46, d: 120, t: 460 }, { y: 31, h: 3, w: 88, d: 0, t: 600 },
  { y: 44, h: 14, w: 38, d: 200, t: 420 }, { y: 57, h: 2, w: 64, d: 80, t: 540 }, { y: 68, h: 6, w: 52, d: 260, t: 460 },
  { y: 79, h: 3, w: 80, d: 150, t: 580 }, { y: 90, h: 10, w: 34, d: 40, t: 440 },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={icon} />
  <meta name="theme-color" content="#04090D" />
  <link rel="preload" href={script.url} as="font" type="font/woff2" crossorigin />
  <style set:html={firstCss}></style>
  {others.map(p => <link rel="prefetch" href={p.href} />)}

  <script is:inline>
    // Runs before first paint. Small on purpose.
    (() => {
      const root = document.documentElement;
      root.classList.add('js');

      // Arriving through a page-to-page view transition (.vt): skip entrance animations so the morph lands
      // cleanly, and pick the leap direction — dive into a section, rise back home (creed.css).
      // A fresh load (.fresh) gets the Animus sync-in instead.
      const depth = url => { try { const p = new URL(url, location.href).pathname; return p === '/' || p === '/index.html' ? 0 : 1; } catch { return 1; } };
      if ('onpagereveal' in window) {
        addEventListener('pagereveal', e => {
          if (!e.viewTransition) { root.classList.add('fresh'); return; }
          root.classList.add('vt');
          const act = window.navigation && navigation.activation;
          const from = act && act.from ? act.from.url : document.referrer;
          root.dataset.leap = depth(location.href) < depth(from) ? 'rise' : 'dive';
          e.viewTransition.finished.finally(() => delete root.dataset.leap);
        });
      } else {
        root.classList.add('fresh');
      }

      document.addEventListener('DOMContentLoaded', () => {
        // Entrance reveals: elements fade up as they scroll into view, staggered among siblings.
        const io = new IntersectionObserver(entries => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -5% 0px' });

        const counts = new Map();
        document.querySelectorAll('.reveal, .ledger .result, .thumbs button').forEach(el => {
          const p = el.parentElement;
          const n = counts.get(p) || 0;
          counts.set(p, n + 1);
          if (n) el.style.setProperty('--i', n);
          io.observe(el);
        });

        // Endless (transform-only) loops pause while they are off-screen.
        const vis = new IntersectionObserver(entries => {
          for (const e of entries) e.target.classList.toggle('offscreen', !e.isIntersecting);
        });
        document.querySelectorAll('.bars, .stage-bars, .playlist').forEach(el => vis.observe(el));

        // Pointer-follow sheen on [data-glow] panels.
        document.querySelectorAll('[data-glow]').forEach(el => {
          el.addEventListener('pointermove', e => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
            el.style.setProperty('--my', (e.clientY - r.top) + 'px');
          }, { passive: true });
        });
      });
    })();
  </script>
</head>
<body class={`page-${page}`}>

  <header class="nav">
    {page !== 'home' && <a class="wordmark ink" href="/">Anoren</a>}
    <nav class="nav-links">
      {nav.map(n => <a href={n.href} aria-current={n.key === page ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </header>

  <slot />

  <footer class="footer">
    <span>anoren.me</span>
  </footer>

  <!-- Animus sync-in: data slices that sweep across once as the page arrives (creed.css). -->
  <div class="sync" aria-hidden="true">
    {slices.map(s => <i style={`--y:${s.y}%;--h:${s.h}px;--w:${s.w}%;--d:${s.d}ms;--t:${s.t}ms`}></i>)}
  </div>

  <script>
    import '../scripts/eagle';
  </script>

</body>
</html>
